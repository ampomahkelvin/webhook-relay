{
  "name": "webhook-inbox",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant, producer-agnostic webhook delivery service backed by PostgreSQL as the queue",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "api": "tsx src/api/index.ts",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pino": "^9.12.0",
    "pino-http": "^10.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testcontainers/postgresql": "^11.4.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "supertest": "^7.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
