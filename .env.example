# Webhook-inbox environment. Copy to .env for local (non-Docker) runs.
# These are development placeholders only.

DATABASE_URL=postgres://webhook:webhook@localhost:5433/webhook
# 32 bytes base64; encrypts endpoint signing secrets.
ENCRYPTION_KEY=nfxwkRb9px9u/baXe41g2X1qA/v6ADr22Cj1mfkJ1k=
# Separate from tenant API keys.
ADMIN_API_KEY=whkadmin_dev_only

PORT=3000
LOG_LEVEL=info

MAX_ENDPOINTS_PER_TENANT=20
DISPATCHER_CONCURRENCY=50
CLAIM_BATCH_SIZE=100
PER_ENDPOINT_CLAIM_CAP=10
POLL_INTERVAL_MS=500
LEASE_SECONDS=60
REQUEST_TIMEOUT_MS=10000
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=60
DELIVERY_MAX_AGE_HOURS=72
AUTO_DISABLE_AFTER_DAYS=5
RETENTION_DAYS=30

# Development escape hatches — keep off.
ALLOW_INSECURE_HTTP=false
ALLOW_PRIVATE_TARGETS=false
